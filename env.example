# ─────────────────────────────────────────────
# CALYMIA — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais committer .env.local dans Git
# ─────────────────────────────────────────────

# ── SUPABASE ──────────────────────────────────
# Récupérer dans : supabase.com → projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── STRIPE ────────────────────────────────────
# Dev : clés sk_test_... / whsec_test_...
# Prod : clés sk_live_... / whsec_live_...
# Webhook en local : stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── SENDGRID ──────────────────────────────────
# Récupérer dans : app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG....

# ── TWILIO (Pro+ — SMS rappels J-1) ───────────
# Récupérer dans : console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+33...

# ── CRON SECRET ───────────────────────────────
# Générer avec : openssl rand -hex 32
# Doit correspondre à la variable dans n8n docker-compose
# ATTENTION : valeur différente entre dev et prod
CRON_SECRET=...

# ── APP URL ───────────────────────────────────
# Dev : http://localhost:3000
# Prod : https://app.calymia.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
