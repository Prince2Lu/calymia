    {
      "parameters": {
        "jsCode": "const allPlaces = [];\nfor (const item of $input.all()) {\n  allPlaces.push(...(item.json.places || []));\n}\nconst seen = new Set();\nconst unique = [];\nfor (const p of allPlaces) {\n  const tel = (p.nationalPhoneNumber || '').replace(/\\s/g, '');\n  const key = tel || (p.displayName && p.displayName.text) || Math.random().toString();\n  if (!seen.has(key)) { seen.add(key); unique.push(p); }\n}\nreturn [{ json: { places: unique, total_brut: allPlaces.length, total_unique: unique.length } }];"
      },
      "id": "6a8e91ab-1431-4e7a-8523-f3351db2cef1",
      "name": "Fusionner 16 requêtes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1408,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const dernierID = $('Calculer dernier ID').first().json.lastID || 0;\nconst telsExistants = $('Calculer dernier ID').first().json.telsExistants || [];\nconst places = $input.first().json.places || [];\n\nconst motsCles = [\n  'sophrologue','sophrologie','cabinet','therapie','therapeute','therapies',\n  'hypnotherapeute','hypnose','naturopathe','coach','coaching','bien-etre',\n  'bien etre','sante','certifie','certifiee','rncp','visio','stress',\n  'anxiete','sommeil','doula','numerologue','perinatale','perinatalite',\n  'specialise','specialisee','relaxation','mindfulness','pleine','conscience',\n  'stop','emotions','debordantes','paris','lyon','marseille','bordeaux',\n  'toulouse','nantes','lille','strasbourg','rennes','grenoble','nice',\n  'montpellier','metz','nancy','rouen','centre','nord','sud','est','ouest',\n  'vieux','vieille','rive','droite','gauche','plateau','haut'\n];\n\nconst cap = s => s.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\nconst results = [];\nlet idCounter = dernierID;\n\nfor (const place of places) {\n  const tel = (place.nationalPhoneNumber || '').replace(/\\s/g, '');\n  if (tel && telsExistants.includes(tel)) continue;\n\n  const raw = (place.displayName && place.displayName.text) ? place.displayName.text : '';\n  const nomCabinet = raw;\n\n  let nomNettoye = raw.split(/[-|·•,]/)[0].trim();\n  const regex = new RegExp('\\\\b(' + motsCles.join('|') + ')\\\\b', 'gi');\n  nomNettoye = nomNettoye.replace(regex, '').replace(/\\s+/g, ' ').trim();\n  nomNettoye = cap(nomNettoye);\n\n  const parts = nomNettoye.split(' ').filter(p => p.length > 1);\n  const prenom = parts[0] || raw;\n  const nom = parts.slice(1).join(' ') || '';\n\n  const adresse = place.formattedAddress || '';\n  const cpMatch = adresse.match(/(\\d{5})/);\n  const dept = cpMatch ? cpMatch[1].substring(0, 2) : '';\n  const villeMatch = adresse.match(/\\d{5}\\s+(.+?)(?:,|$)/);\n  const ville = villeMatch ? villeMatch[1].trim() : '';\n\n  idCounter++;\n  results.push({\n    json: {\n      'ID': idCounter,\n      'Prénom': prenom,\n      'Nom': nom,\n      'Nom Cabinet': nomCabinet,\n      'Ville': ville,\n      'Dép.': dept,\n      'Téléphone': place.nationalPhoneNumber || '',\n      'Email': '',\n      'Note Google ★': place.rating ? place.rating.toString() : '',\n      'Nb Avis': place.userRatingCount ? place.userRatingCount.toString() : '',\n      'Site Web': place.websiteUri || '',\n      'Bouton Résa ?': 'Non',\n      'Source': 'Google Maps',\n      'Statut': 'À appeler',\n      'Canal Gagnant': '',\n      'Date Contact': '',\n      'Notes': 'Extrait le ' + new Date().toLocaleDateString('fr-FR')\n    }\n  });\n}\nreturn results;"
      },
