      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://places.googleapis.com/v1/places:searchText",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Goog-Api-Key",
              "value": "AIzaSyDCMXJGSWMwb4svGl6NjDDeKLr07pMK2QY"
            },
            {
              "name": "X-Goog-FieldMask",
              "value": "places.displayName,places.formattedAddress,places.nationalPhoneNumber,places.websiteUri,places.rating,places.userRatingCount"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"textQuery\": \"sophrologue Paris 75020\", \"languageCode\": \"fr\", \"maxResultCount\": 20}",
        "options": {}
      },
      "id": "fe0b4e67-13b2-4663-90f7-58aec029463e",
      "name": "Places — Paris 20ème",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        3024,
        6672
      ]
    },
    {
      "parameters": {
        "jsCode": "// Fusionner les 20 requêtes Places\nconst allPlaces = [];\nfor (const item of $input.all()) {\n  const places = item.json.places || [];\n  allPlaces.push(...places);\n}\n// Dédoublonner par téléphone entre les requêtes\nconst seen = new Set();\nconst unique = [];\nfor (const p of allPlaces) {\n  const tel = (p.nationalPhoneNumber || '').replace(/\\s/g, '');\n  const key = tel || (p.displayName && p.displayName.text) || Math.random().toString();\n  if (!seen.has(key)) {\n    seen.add(key);\n    unique.push(p);\n  }\n}\nreturn [{ json: { places: unique, total_brut: allPlaces.length, total_unique: unique.length } }];"
      },
      "id": "4324d60e-fcc9-4180-bb87-c9fdb42b69a7",
      "name": "Fusionner 20 requêtes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3248,
        4848
      ]
    },
    {
      "parameters": {
        "jsCode": "const dernierID = $('Calculer dernier ID').first().json.lastID || 0;\nconst telsExistants = $('Calculer dernier ID').first().json.telsExistants || [];\nconst places = $input.first().json.places || [];\n\nconst motsCles = ['sophrologue','sophrologie','cabinet','therapie','therapeute','therapies','hypnotherapeute','hypnose','naturopathe','coach','coaching','bien-etre','bien etre','sante','certifie','certifiee','rncp','visio','stress','anxiete','sommeil','doula','numerologue','perinatale','perinatalite','specialise','specialisee','relaxation','mindfulness','pleine','conscience','stop','emotions','debordantes','paris','lyon','marseille','bordeaux','toulouse','nantes','lille','strasbourg','rennes','grenoble','nice','montpellier','metz','nancy'];\n\nconst cap = s => s.toLowerCase().replace(/\\b\\w/g, c => c.toUpperCase());\nconst values = [];\nlet idCounter = dernierID;\n\nfor (const place of places) {\n  const tel = (place.nationalPhoneNumber || '').replace(/\\s/g, '');\n  if (tel && telsExistants.includes(tel)) continue;\n\n  const raw = (place.displayName && place.displayName.text) ? place.displayName.text : '';\n  let nomNettoye = raw.split(/[-|\\u00b7\\u2022,]/)[0].trim();\n  const regex = new RegExp('\\\\b(' + motsCles.join('|') + ')\\\\b', 'gi');\n  nomNettoye = nomNettoye.replace(regex, '').replace(/\\s+/g, ' ').trim();\n  nomNettoye = cap(nomNettoye);\n  const parts = nomNettoye.split(' ').filter(p => p.length > 1);\n  const prenom = parts[0] || raw;\n  const nom = parts.slice(1).join(' ') || '';\n\n  const adresse = place.formattedAddress || '';\n  const cpMatch = adresse.match(/(\\d{5})/);\n  const dept = cpMatch ? cpMatch[1].substring(0, 2) : '75';\n\n  idCounter++;\n  values.push([\n    String(idCounter), prenom, nom, raw, 'Paris', dept,\n    place.nationalPhoneNumber || '', '',\n    place.rating ? String(place.rating) : '',\n    place.userRatingCount ? String(place.userRatingCount) : '',\n    place.websiteUri || '', 'Non', 'Google Maps', 'A appeler', '', '',\n    'Extrait le ' + new Date().toLocaleDateString('fr-FR')\n  ]);\n}\n\nif (values.length === 0) {\n  return [{ json: { skipped: true, count: 0 } }];\n}\n\nreturn [{ json: { values: values, majorDimension: 'ROWS', count: values.length } }];"
      },
      "id": "66379f60-58d1-47ef-8ecd-62dee644cf12",
      "name": "Extraire et dédoublonner",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3472,
        4848
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nif (input.skipped || !input.values || input.values.length === 0) {\n  return [{ json: { skipped: true, body: '' } }];\n}\nconst body = JSON.stringify({\n  values: input.values,\n  majorDimension: 'ROWS'\n});\nreturn [{ json: { body: body, count: input.values.length } }];"
      },
