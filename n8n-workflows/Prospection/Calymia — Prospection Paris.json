      "parameters": {
        "jsCode": "const items = $input.all ? $input.all() : [];\nif (!items || items.length === 0) {\n  return [{ json: { lastID: 0, telsExistants: [] } }];\n}\nconst ids = items.map(r => parseInt(r.json['ID']) || 0).filter(n => n > 0);\nconst dernierID = ids.length > 0 ? Math.max(...ids) : 0;\nconst tels = items.map(r => (r.json['Telephone'] || r.json['T\\u00e9l\\u00e9phone'] || '').replace(/\\s/g, '')).filter(t => t.length > 0);\nreturn [{ json: { lastID: dernierID, telsExistants: tels } }];"
      },
