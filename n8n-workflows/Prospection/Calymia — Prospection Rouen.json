      "parameters": {
        "jsCode": "const items = $input.all();\nconst ids = items.map(r => parseInt(r.json['ID']) || 0).filter(n => n > 0);\nconst dernierID = ids.length > 0 ? Math.max(...ids) : 0;\nconst tels = items.map(r => (r.json['Téléphone'] || '').replace(/\\s/g, '')).filter(t => t.length > 0);\nreturn [{ json: { lastID: dernierID, telsExistants: tels } }];"
      },
