    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rawText = response.content[0].text;\n\nconst categorieMap = {\n  10: 'Thérapies & bien-être',\n  11: 'Stress & anxiété',\n  12: 'Sommeil',\n  13: 'Publics spécifiques',\n  14: 'Pratique & quotidien',\n  15: 'Santé mentale'\n};\n\nlet sujets;\ntry {\n  const cleaned = rawText.replace(/^```json\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  sujets = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Parse error : ' + rawText.substring(0, 300));\n}\n\nif (!Array.isArray(sujets) || sujets.length === 0) {\n  throw new Error('Tableau vide ou invalide');\n}\n\nconst lastId = $('Préparer prompt Claude').first().json.lastId;\n\nconst rows = sujets.map((s, i) => {\n  const num = lastId + i + 1;\n  const id = 'art-' + String(num).padStart(3, '0');\n  const categorieId = parseInt(s.categorie_id || s.categorie);\n  const categorieNom = categorieMap[categorieId] || s.categorie || '';\n  const motsCles = Array.isArray(s.mots_cles_secondaires)\n    ? s.mots_cles_secondaires.join(', ')\n    : (s.mots_cles_secondaires || '');\n\n  return {\n    id, statut: 'pending',\n    titre: s.titre,\n    categorie: categorieNom,\n    categorie_id: categorieId,\n    mot_cle_principal: s.mot_cle_principal,\n    mots_cles_secondaires: motsCles,\n    meta_description: s.meta_description,\n    prompt_image: s.prompt_image,\n    angle: s.angle || '',\n    wp_post_id: '',\n    date_publication: ''\n  };\n});\n\nconst resume = rows.map(r => `• ${r.id} — ${r.titre}`).join('\\n');\nreturn rows.map(r => ({ json: { ...r, resume } }));"
      },
