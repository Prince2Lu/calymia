    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst existingTitles = rows.map(r => (r.json.titre || '').toLowerCase());\nconst existingKeywords = rows.map(r => (r.json.mot_cle_principal || '').toLowerCase());\nconst lastId = rows.reduce((max, r) => {\n  const num = parseInt((r.json.id || 'art-000').replace('art-', ''));\n  return num > max ? num : max;\n}, 0);\n\nconst system = \"Tu es expert SEO et rédacteur spécialisé bien-être et sophrologie pour le blog Calymia. Génère exactement 10 nouveaux sujets d'articles de blog. Catégories : Thérapies & bien-être (id:10), Stress & anxiété (id:11), Sommeil (id:12), Publics spécifiques (id:13), Pratique & quotidien (id:14), Santé mentale (id:15). Règles : titres 50-70 chars, meta_description exactement 150-160 chars, mots_cles_secondaires en STRING séparée par virgules (JAMAIS un tableau JSON), prompt_image scène calme crème et vert sans visage, angle éditorial précis avec ton format longueur. Varie les catégories max 3 par catégorie. Réponds UNIQUEMENT avec un tableau JSON valide sans backticks ni texte avant ou après.\";\n\nconst userMessage = \"Génère 10 nouveaux sujets pour le blog Calymia. Titres existants à ne pas répéter : \" + existingTitles.join(' | ') + \". Mots-clés déjà couverts : \" + existingKeywords.join(' | ') + \". IMPORTANT : mots_cles_secondaires doit être une STRING séparée par virgules.\";\n\nconst claudeBody = JSON.stringify({\n  model: \"claude-sonnet-4-6\",\n  max_tokens: 8000,\n  system: system,\n  messages: [{ role: \"user\", content: userMessage }]\n});\n\nreturn [{ json: { claudeBody, lastId, existingCount: rows.length } }];"
      },
