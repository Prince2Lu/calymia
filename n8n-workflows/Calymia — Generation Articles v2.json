    {
      "parameters": {
        "jsCode": "const postId = $input.first().json.id;\nconst postStatus = $input.first().json.status;\nconst prevData = $('Préparer payload WordPress').first().json;\n\nreturn [{\n  json: {\n    id: prevData.subject.id,\n    postId: postId,\n    postStatus: postStatus,\n    postLink: 'https://www.calymia.com/?p=' + postId,\n    postTitle: prevData.article.titre_seo,\n    categorie: prevData.subject.categorie,\n    statut: 'done',\n    wp_post_id: postId,\n    date_publication: new Date().toISOString().split('T')[0]\n  }\n}];"
      },
