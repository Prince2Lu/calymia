    {
      "parameters": {
        "jsCode": "const mediaId = parseInt($input.first().json.id);\nconst articleData = $('Extraire URL image').first().json;\nconst article = articleData.article;\nconst subject = articleData.subject;\n\n// Construire le body WP comme objet puis le stringifier\n// status 'draft' garanti — pas de risque de publication accidentelle\nconst wpBodyObj = {\n  title: article.titre_seo,\n  content: article.contenu_html,\n  slug: article.slug,\n  status: 'draft',\n  featured_media: mediaId,\n  categories: [parseInt(subject.categorie_id)]\n};\n\nreturn [{\n  json: {\n    mediaId,\n    article,\n    subject,\n    allSubjects: articleData.allSubjects,\n    filePath: articleData.filePath,\n    wpTitle: wpBodyObj.title,\n    wpContent: wpBodyObj.content,\n    wpSlug: wpBodyObj.slug,\n    wpStatus: 'draft',\n    wpFeaturedMedia: mediaId,\n    wpCategories: [parseInt(subject.categorie_id)]\n  }\n}];"
      },
