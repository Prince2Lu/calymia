    {
      "parameters": {
        "jsCode": "const response = $input.first().json;\nconst rawText = response.content[0].text;\n\nlet article;\ntry {\n  const cleaned = rawText.replace(/^```json\\s*/i, '').replace(/```\\s*$/i, '').trim();\n  article = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Impossible de parser la réponse Claude en JSON. Réponse brute : ' + rawText.substring(0, 500));\n}\n\nif (!article.titre_seo || !article.contenu_html || !article.slug) {\n  throw new Error('Réponse Claude incomplète — champs manquants');\n}\n\nconst prevData = $('Lire sujet suivant').first().json;\nconst subject = {\n  ...prevData,\n  categorie_id: parseInt(prevData.categorie_id),\n  mots_cles_secondaires: prevData.mots_cles_secondaires.split(',').map(s => s.trim())\n};\n\nreturn [{ json: { article, subject, filePath: '' } }];"
      },
